BOT_TOKEN=            # от @BotFather
WEBHOOK_SECRET=       # любая длинная случайная строка
WEBAPP_URL=https://   # публичный HTTPS-адрес, где крутится этот сервер
PORT=3000
DB_PATH=./sloy.db
TZ_NAME=Europe/Moscow
DOMAIN=sloy.example.com   # ваш домен, тот же что в WEBAPP_URL (без https://)
ADMIN_IDS=            # Telegram ID админов через запятую (узнать: написать боту /id)
# --- необязательное ---
# KEEP_DAYS=30          # сколько дней хранить сообщения
# RECAP_HOUR=21         # час вечернего RECAP (по TZ_NAME)
# QUIET_FROM=23         # тихие часы: с какого часа
# QUIET_TO=8            # ...до какого
# BACKUP_DIR=/data/backups
